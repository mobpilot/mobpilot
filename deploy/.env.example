# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=unimob
POSTGRES_PASSWORD=unimob_dev          # Change in production!
POSTGRES_DB=unimob

# ─── MinIO ───────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=unimob
MINIO_ROOT_PASSWORD=unimob_dev_secret # Change in production!

# ─── Meilisearch ──────────────────────────────────────────────────────────────
MEILI_MASTER_KEY=unimob_search_dev    # Change in production!

# ─── Ory Hydra ────────────────────────────────────────────────────────────────
HYDRA_SECRETS_SYSTEM=youReallyNeedToChangeThis32charSecret  # Min 32 chars, change in production!
HYDRA_PUBLIC_URL=http://localhost:4444
HYDRA_LOGIN_URL=http://localhost:3000/login
HYDRA_CONSENT_URL=http://localhost:3000/consent
HYDRA_LOGOUT_URL=http://localhost:3000/logout

# ─── Email (dev uses MailHog) ─────────────────────────────────────────────────
SMTP_URI=smtp://mailhog:1025/?skip_ssl_verify=true

# ─── Observability ────────────────────────────────────────────────────────────
# Set to your OTel collector endpoint in production
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ─── Push notifications (per app, configure after creating apps) ──────────────
# FCM service account JSON path (or use Kubernetes Secret in production)
# FCM_SERVICE_ACCOUNT_PATH=/run/secrets/fcm-sa.json

# APNs configuration (per app, stored in apps.push_config)
# APNS_KEY_ID=your_key_id
# APNS_TEAM_ID=your_team_id
# APNS_KEY_PATH=/run/secrets/apns.p8

# ─── Service version ──────────────────────────────────────────────────────────
SERVICE_VERSION=dev
